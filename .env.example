NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Phase 8 Ask Jace AI — server only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Current default can be overridden without changing code.
OPENAI_MODEL=gpt-5.6
# Optional for compatible gateways/testing. Defaults to OpenAI's API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Phase 10 Web Push — public VAPID key is safe for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never prefix these with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
